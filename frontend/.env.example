# Local development (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Local frontend origin (robots.txt Sitemap line, OpenGraph url, sitemap fallback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pull static images/uploads from live API into backend/public:
#   npm run sync:images

# Production (split deploy — Hostinger API + Vercel frontend; see docs/DEPLOYMENT.md)
# Set these on the Vercel project (Production). Canonical site is www;
# apex sunbirdvacations.com already 308-redirects to www on Vercel.
# NEXT_PUBLIC_API_URL=https://backend.sunbirdvacations.com/api
# NEXT_PUBLIC_SITE_URL=https://www.sunbirdvacations.com
# BUILD_API_URL=https://backend.sunbirdvacations.com/api

# Legacy single-domain Hostinger static export (optional; sets STATIC_EXPORT=1):
#   npm run build:live
# Do NOT use build:live as the primary path when the frontend is on Vercel.
# See docs/DEPLOYMENT.md
