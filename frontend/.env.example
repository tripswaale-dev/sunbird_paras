# Local development
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Local frontend origin (robots.txt Sitemap line, OpenGraph url, sitemap fallback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production: set to your deployed Laravel API base URL (must include /api suffix)
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# Production: must match backend FRONTEND_URL in the same environment
# NEXT_PUBLIC_SITE_URL=https://sunbirdvacations.com
