# Local development (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Local frontend origin (robots.txt Sitemap line, OpenGraph url, sitemap fallback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pull static images/uploads from live API into backend/public:
#   npm run sync:images

# Production (single domain — see docs/DEPLOYMENT.md):
# NEXT_PUBLIC_API_URL=https://sunbirdvacations.com/api
# NEXT_PUBLIC_SITE_URL=https://sunbirdvacations.com
# BUILD_API_URL=http://127.0.0.1:8000/api

# Production static build (copies export into backend/public):
#   npm run build:live
# See docs/DEPLOYMENT.md
